{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@courtsync/core/*": ["packages/core/src/*"],
      "@courtsync/ui-components/*": ["packages/ui-components/src/*"],
      "@courtsync/shared-hooks/*": ["packages/shared-hooks/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}
